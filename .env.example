APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shask
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ruta secreta del back office (sin valor => panel deshabilitado)
ADMIN_PATH=

# Precios de hype del ciclo de vida de buzones (rewarded ad = alternativa gratis)
HYPE_EXTEND=20
HYPE_UNLOCK=15
HYPE_REVIVE=30

# Duración del ciclo de un buzón en minutos (4320 = 72h). Bajalo para testear.
MAILBOX_LIFETIME_MINUTES=4320

# ── AdMob rewarded SSV (anti-fraude de los assets premium) ───────────────────
# SEGURIDAD: en producción, ADMOB_SSV_ENFORCE=true y ADMOB_LEGACY_AD_GRACE=false.
# Sin esto, un cliente clonado desbloquea premium sin ver un ad real (fake-ad).
#
# ADMOB_LEGACY_AD_GRACE: SOLO para desarrollo. En true, deja pasar los requests
# premium SIN nonce verificado (útil cuando los test ads no disparan el callback
# SSV). VOLVER A false antes de desplegar.
ADMOB_SSV_ENFORCE=true
ADMOB_LEGACY_AD_GRACE=false
# Ventana en la que un nonce emitido sigue siendo gastable.
ADMOB_NONCE_TTL_MINUTES=30
# Puntaje de reputación que se mintea al creador por cada uso premium.
ADMOB_CREATOR_REWARD_MINT=15

# Salt secreto del hash de visitantes únicos (visit-analytics).
# NO afecta el conteo: la unicidad diaria la da la columna `day` (CURDATE()) en
# post_view_dedup, no el salt. El salt solo hace el hash irreconstruible
# (anti rainbow-table sobre ip+user_agent). Poné UNA cadena aleatoria larga,
# generada una vez, y dejala fija (anda bien con `php artisan config:cache`).
# Generar: `openssl rand -hex 32`.
VISIT_TRACKING_DAILY_SALT=
